<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Integral.App</RootNamespace>
    <AssemblyName>Integral</AssemblyName>
    <UseWindowsForms Condition="'$(OS)' == 'Windows_NT'">true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <AssemblyTitle>Интегрирование функций</AssemblyTitle>
    <Product>Интегрирование функций</Product>
    <Description>Вычисление определённого интеграла функции, заданной формулой, методами трапеций и Симпсона</Description>
    <Company>ФГБОУ ВО «ДонГТУ»</Company>
    <Authors>Кириенко А.М.</Authors>
    <Copyright>© 2026 Кириенко А.М., группа БИ-25</Copyright>
  </PropertyGroup>
  <!-- Сборка вне Windows (проверка в облаке): прямые ссылки на библиотеки .NET Framework -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Resources\Help.txt" LogicalName="Help.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\Integral.Core\Integral.Core.csproj" />
  </ItemGroup>
</Project>
